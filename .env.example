# ========================================================
# 全局规范配置文件 (后端 FastAPI、UI 转换 Gateway、前端 UI 共同读取)
# ========================================================

# 1. 业务与协议统一 API 规范前缀
API_PREFIX=/api

# 2. 服务端口配置
FASTAPI_PORT=8123
GATEWAY_PORT=4000
HOST=0.0.0.0

# 3. 本地数据库存储与附件目录 (PostgreSQL)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=deepagent
POSTGRES_USER=deepagent
POSTGRES_PASSWORD=deepagent_secret
# DATABASE_URL=postgres://deepagent:deepagent_secret@127.0.0.1:5432/deepagent
UPLOAD_DIR=uploads

# 4. 模型配置
MODEL_NAME=deepseek-v4.1-flash-1017
MODEL_PROVIDER=openai
MODEL_BASE_URL=https://api.modelarts-maas.com/plan/v2
MODEL_API_KEY=your_model_api_key_here

# 5. Agent 运行配置
AGENT_RECURSION_LIMIT=100

# 6. AgentArts 沙箱配置 (Code Interpreter)
AGENTARTS_CODE_INTERPRETER_NAME=deepagent-sandbox
AGENTARTS_CODEINTERPRETER_DATA_ENDPOINT=
AGENTARTS_REGION=cn-southwest-2
AGENTARTS_WORKSPACE=/home/user
AGENTARTS_SESSION_TIMEOUT=3600

# 7. AgentArts 云浏览器配置 (Browser Use / 远程 CDP)
AGENTARTS_BROWSER_NAME=deepagent-browser
AGENTARTS_BROWSER_DATA_ENDPOINT=https://your-agentarts-endpoint.cn-southwest-2.huaweicloud-agentarts.com
AGENTARTS_BROWSER_AUTH_TYPE=IAM
AGENTARTS_BROWSER_SESSION_TIMEOUT=900

# 8. AgentArts 长期记忆配置
AGENTARTS_MEMORY_SPACE_ID=your_memory_space_id_here
AGENTARTS_MEMORY_API_KEY=your_memory_api_key_here
AGENTARTS_MEMORY_TOP_K=5

# 9. 华为云 IAM 凭据 (供 AgentArts SDK 沙箱与浏览器认证)
# HUAWEICLOUD_SDK_AK=your_huaweicloud_ak_here
# HUAWEICLOUD_SDK_SK=your_huaweicloud_sk_here

# 10. 本地 AgentArts 请求转发代理服务配置 (用于本地与远端 AgentArts 后端联调，绕过浏览器跨域并自动注入凭据)
AGENTARTS_BACKEND_URL=https://your-agentarts-endpoint.huaweicloud-agentarts.com
AGENTARTS_AUTH_TOKEN=your_auth_token_here
AGENTARTS_SESSION_ID=your_agentarts_session_id_here
PROXY_PORT=8000

