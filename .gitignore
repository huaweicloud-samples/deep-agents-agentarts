# ========================================================
# Git Ignore Configuration for DeepAgent
# ========================================================

# 1. Python & Build Artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
dist-ssr/
wheels/
*.egg
*.egg-info/
.installed.cfg

# 2. Python Testing, Linting & Type Checking
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# 3. Virtual Environments & Package Managers
.venv/
venv/
env/
ENV/
node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 4. Vite & Frontend Caches
.vite/
*.local

# 5. Database, Storage & Attachments
*.db
*.db-*
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
uploads/*
!uploads/.gitkeep

# 6. Logs & Runtime Output
logs/
*.log

# 7. LangGraph CLI & Agent Cache
.langgraph_api/
*.pckl

# 8. Environment & Sensitive Configuration
.env
.env.*
!.env.example

# 9. Operating System & IDE Artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
